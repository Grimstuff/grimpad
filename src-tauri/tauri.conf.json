{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimpad",
  "version": "0.6.1",
  "identifier": "com.grimmers.grimpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimpad",
        "width": 720,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src", "style-src-elem", "style-src-attr"],
      "csp": {
        "default-src": "'self' customprotocol: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://tauri.localhost https://tauri.localhost",
        "img-src": "'self' asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost blob: data:",
        "font-src": "'self' data: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "style-src": "'self' 'unsafe-inline' blob: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "style-src-elem": "'self' 'unsafe-inline' blob: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "style-src-attr": "'unsafe-inline'",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval' 'unsafe-inline' blob: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "worker-src": "'self' blob: data: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "child-src": "'self' blob: data: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRDExRTZEODdGRDZCQ0IKUldUTGEvMkhiUjdSZW9LQWFZenlIYjhZU3JveWNXNGtGbnBUV3FqZmk0bENhV1RsRjY0Y09kQk8K",
      "endpoints": ["https://github.com/Grimstuff/grimpad/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "text", "log", "nfo", "inf", "ini", "cfg", "conf", "nsh", "properties",
          "md", "markdown", "mdx", "mdown", "rst", "tex",
          "json", "jsonc", "json5",
          "js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx",
          "html", "htm", "xhtml", "css", "scss", "sass", "less",
          "xml", "svg", "xsl", "xslt", "xsd", "dtd", "plist",
          "yaml", "yml", "toml",
          "py", "pyw", "pyi", "rs", "go", "java", "kt", "kts", "cs", "fs", "fsx",
          "cpp", "cxx", "cc", "c", "h", "hpp", "hxx", "m", "mm",
          "rb", "php", "phtml", "pl", "pm",
          "sh", "bash", "zsh", "ps1", "psm1", "psd1", "bat", "cmd", "vbs",
          "sql", "r", "lua", "swift", "dart", "vue", "svelte",
          "graphql", "gql", "proto", "csv", "tsv",
          "diff", "patch", "cmake", "mk", "asm",
          "env", "gitignore", "gitattributes", "editorconfig", "htaccess", "npmrc",
          "srt", "vtt", "reg"
        ],
        "name": "Grimpad Document",
        "description": "Open with Grimpad",
        "role": "Editor"
      }
    ]
  }
}
