{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimpad",
  "version": "0.3.0",
  "identifier": "com.grimmers.grimpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimpad",
        "width": 720,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "script-src": "'self' 'unsafe-eval' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "text", "log", "md", "markdown", "mdx", "json", "jsonc", "js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx", "html", "htm", "css", "scss", "less", "xml", "svg", "yaml", "yml", "toml", "ini", "cfg", "conf", "py", "rs", "go", "java", "cs", "cpp", "c", "h", "hpp", "rb", "php", "sh", "bash", "ps1", "bat", "cmd", "sql", "r", "lua", "csv", "env", "gitignore", "editorconfig"],
        "name": "Grimpad Document",
        "description": "Open with Grimpad",
        "role": "Editor"
      }
    ]
  }
}
